# ── Database (Neon) ─────────────────────────────────────────────
# Create a project at https://neon.tech and paste the pooled connection string.
# Leave empty to use an in-memory demo database (data resets on restart).
DATABASE_URL=

# ── Better Auth ─────────────────────────────────────────────────
# Generate with:  openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public URL of the app (http://localhost:3000 locally, your domain in production)
BETTER_AUTH_URL=http://localhost:3000

# ── Sign-in emails ──────────────────────────────────────────────
# Without a key the app runs in DEMO mode: the sign-in code is shown on screen for any email.
# Add a Resend key (https://resend.com) to email real codes and turn demo mode off automatically.
RESEND_API_KEY=
EMAIL_FROM="CarePass <onboarding@resend.dev>"

# Set to "off" to disable on-screen codes, sample data and the sponsor→family preview.
# DEMO_MODE=off

# ── MoonPay (card/bank funding) ─────────────────────────────────
# Dashboard → Developers. Use the sandbox (test) keys until you go live.
# Leave empty to fall back to instant sandbox funding with no card step.
MOONPAY_PUBLISHABLE_KEY=
MOONPAY_SECRET_KEY=
MOONPAY_WEBHOOK_KEY=
# Currency delivered to the sponsor's Stellar wallet. Check the exact code for Stellar testnet in your MoonPay dashboard.
# MOONPAY_CURRENCY_CODE=xlm_testnet
# Webhook URL to register in MoonPay: https://<your-domain>/api/webhooks/moonpay

# Set to "sandbox" to skip MoonPay and fund passes instantly (no card step). Useful if MoonPay isn't reachable.
# FUNDING_MODE=sandbox

# --- Network connection (Stellar testnet). Leave unset to run without it. ---
# Run contracts/scripts/chain-env.sh after deploying and paste its output here.
# CHAIN_ADMIN_SECRET=      # registry admin; also deploys each family vault
# CHAIN_ISSUER_SECRET=     # test-USDC mode only: issues the USDC deposited into vaults
# CHAIN_USDC_ISSUER=       # real-USDC mode: issuer from the anchor's stellar.toml (defaults to Circle's testnet issuer; confirm it)
# CHAIN_ANCHOR_DOMAIN=testanchor.stellar.org   # SEP-10 / SEP-24 anchor for "Stellar USDC" funding
# ANCHOR_FUNDING=off       # hides the Stellar USDC option
# CHAIN_REGISTRY_ID=
# CHAIN_TOKEN_ID=
# CHAIN_PASS_WASM_HASH=
# CHAIN_NETWORK=testnet   # CHAIN_RPC_URL, CHAIN_PASSPHRASE override the testnet defaults

# Naira settlement: after each payment to a clinic, its USDC moves to the settlement account and the clinic is paid in Naira.
# SETTLEMENT_MODE=mock       # mock (simulated bank transfer, default when the network is connected) | paystack | off
# PAYSTACK_SECRET_KEY=       # sk_test_... for SETTLEMENT_MODE=paystack. In the Paystack dashboard, turn off transfer OTP and fund the test balance.
# CHAIN_HORIZON_URL=         # optional: where public receipt checks read the payment's memo (defaults to Stellar's testnet Horizon)
